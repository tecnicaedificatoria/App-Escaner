{
  "expo": {
    "owner": "tecnica-edificatoria-sl",
    "name": "Escáner",
    "slug": "app-escaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tecnicaedificatoria.escaner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tecnicaedificatoria.escaner"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "La cámara se usa para escanear tus documentos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "scheme": "escaner",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "50a7cbd9-9958-48cf-8f94-97f4ea7e5ee8"
      }
    }
  }
}
